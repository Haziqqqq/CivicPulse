# Copy to .env and fill values

DATABASE_URL=postgresql://user:pass@host:5432/dbname
PORT=4000

# Email (optional)
RESEND_API_KEY=

# --- Vision AI (YOLO) ---
AI_ENABLED=true
AI_PYTHON=python
AI_MODEL_PATH=./models/best.pt
AI_CONF=0.25

# subprocess = Node calls python ai/infer.py (default, one deploy folder)
# http = Node calls INFERENCE_URL (run: npm run inference)
INFERENCE_MODE=subprocess
INFERENCE_URL=http://127.0.0.1:8000
INFERENCE_ENABLED=true
INFERENCE_TIMEOUT_MS=120000
